 "steps": [
  {
   "title": "Left end frame",
   "group": "end_l",
   "add": [
    "leg_lf",
    "leg_lb",
    "end_top_l",
    "end_bot_l"
   ],
   "view": "front-left",
   "text": "Lay both legs flat on the floor, then screw the two end rails across them. Check the frame is square by measuring both diagonals - they should match."
  },
  {
   "title": "Right end frame",
   "group": "end_r",
   "add": [
    "leg_rf",
    "leg_rb",
    "end_top_r",
    "end_bot_r"
   ],
   "same_as": 1,
   "text": "Build the second frame as a mirror image: the rails go on the outside."
  },
  {
   "title": "Stand up the left frame",
   "attach": "end_l",
   "view": "front-left",
   "text": "Stand the left frame upright with the rails facing out."
  },
  {
   "title": "Long aprons",
   "add": [
    "apron_f",
    "apron_b"
   ],
   "view": "front-left",
   "text": "Screw the front and back aprons to the left frame, flush with the top of the legs. A helper or clamps make this much easier."
  },
  {
   "title": "Attach the right frame",
   "attach": "end_r",
   "text": "Slide the right frame between the aprons, flush at the top, and screw the aprons to it."
  },
  {
   "title": "Middle rail",
   "add": [
    "rail_mid"
   ],
   "text": "Fit the middle rail between the aprons, flush with their top. It supports the plywood in the middle."
  },
  {
   "title": "Shelf rails",
   "add": [
    "low_f",
    "low_b"
   ],
   "text": "Fit the two shelf rails between the legs, level with the bottom end rails, and screw through the legs."
  },
  {
   "title": "Lower shelf",
   "add": [
    "shelf"
   ],
   "text": "Drop the shelf onto the rails and screw it down to them."
  },
  {
   "title": "Top",
   "add": [
    "top"
   ],
   "view": "front-left",
   "text": "Lay the plywood top flush with the frame on all sides. Screw it into the aprons, end rails and middle rail every 8-10 inches."
  }
 ],
 "tools": [
  "Circular saw or miter saw",
  "Drill/driver",
  "1/8 in drill bit and countersink",
  "Tape measure, pencil, speed square",
  "Two clamps"
 ],
 "extra_materials": [
  "Wood glue (optional)"
 ],
 "tips": [
  "Cut all four legs together, clamped side by side, so they come out exactly the same length.",
  "If the garage floor is uneven, shim under a leg rather than cutting it."
 ]
}