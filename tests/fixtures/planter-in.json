  "steps": [
    {
      "title": "Left end",
      "add": [
        "end_l_lo",
        "end_l_hi",
        "post_fl",
        "post_bl"
      ],
      "view": "front-right",
      "text": "Lay the two end boards flat on the ground, edges together. Set a corner block on each end of the boards, flush with the board ends and the top edge. Drive screws through the end boards into the blocks. Pre-drill to avoid splitting."
    },
    {
      "title": "Right end",
      "add": [
        "end_r_lo",
        "end_r_hi",
        "post_fr",
        "post_br"
      ],
      "view": "front-left",
      "text": "Build the second end the same way, as a mirror image: the blocks go on the inside face."
    },
    {
      "title": "Front side",
      "add": [
        "front_lo",
        "front_hi"
      ],
      "view": "front-right",
      "text": "Stand both ends up. Place the side boards so they cover the ends of the end boards. Screw into the corner blocks and into the end grain of the end boards."
    },
    {
      "title": "Back side",
      "add": [
        "back_lo",
        "back_hi"
      ],
      "view": "back-right",
      "text": "Attach the back side boards the same way. Check the box is square: both diagonals must be equal."
    }
  ],
  "tools": [
    "Circular saw or miter saw",
    "Drill/driver",
    "1/8 in drill bit for pilot holes",
    "Tape measure, pencil, speed square",
    "Sandpaper 80 grit"
  ],
  "extra_materials": [
    "Exterior-rated deck screws (coated or stainless)",
    "Optional: landscape fabric or hardware cloth for the bottom"
  ],
  "tips": [
    "Use cedar, redwood, or lumber treated for ground contact. Do not use OSB or particle board outdoors.",
    "For vegetables, avoid old CCA-treated wood; modern ACQ/CA treated lumber is generally considered acceptable, or line the inside with plastic sheeting.",
    "Level the ground before setting the box so it does not rock.",
    "Lay cardboard or landscape fabric on the bottom to block weeds, then fill with soil mix."
  ]
